# Copiază acest fișier în ".env.local" pentru rulare locală (npm run dev).
# Pentru Vercel, aceleași 4 variabile se pun în Project Settings -> Environment Variables.
# NU comite ".env.local" în git.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=lipeste-aici-service-role-key-ul-din-supabase
APP_PASSWORD=alege-o-parola-a-ta
AUTH_SECRET=un-text-lung-si-aleator-orice-sir-de-caractere
