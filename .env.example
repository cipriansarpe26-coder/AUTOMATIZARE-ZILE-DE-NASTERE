# Copiază acest fișier în ".env" și completează valorile tale reale.
# Le găsești în Meta for Developers -> aplicația ta -> WhatsApp -> API Setup.
# NU comite fișierul ".env" în git (e deja în .gitignore).

META_PHONE_NUMBER_ID=placeholder_phone_number_id
META_ACCESS_TOKEN=placeholder_access_token

# Opțional: calea către fișierul Excel, dacă nu e ZILE.xlsx în directorul curent.
# EXCEL_FILE_PATH=ZILE.xlsx
